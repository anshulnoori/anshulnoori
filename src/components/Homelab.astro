---
import Plate from "./Plate.astro";

// Map-legend groups; each swatch colour matches a part of the diorama.
const left = [
  ["Host", "slate", ["Laptop", "Kubernetes", "NixOS", "Config in Git"]],
  ["Services", "land", ["Email system", "Automations", "AI models on its GPU"]],
] as const;
const right = [
  ["Access", "sea", ["Private remote access", "Single sign-on"]],
  ["Secrets", "ochre", ["Password-manager-backed store"]],
] as const;
---

<section id="homelab" class="sect homelab wrap" aria-labelledby="homelab-h">
  <h2 id="homelab-h" class="sect-label">
    <span>05</span> Homelab
  </h2>
  <h3 class="role-name">A laptop running Kubernetes</h3>
  <p class="role-what">Set up entirely from config files in Git, and running everything I use day to day.</p>

  <div class="lab">
    <div class="legend">
      {left.map(([h, c, items]) => (
        <div>
          <p class="lbl">{h}</p>
          <ul>
            {items.map((t) => (
              <li>
                <i class={`sw sw-${c}`} aria-hidden="true" />
                {t}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <Plate id="homelab" fig={3} />
    <div class="legend">
      {right.map(([h, c, items]) => (
        <div>
          <p class="lbl">{h}</p>
          <ul>
            {items.map((t) => (
              <li>
                <i class={`sw sw-${c}`} aria-hidden="true" />
                {t}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="lbl">Sandbox VM boot</p>
        <p class="lab-big">~2s</p>
        <p class="dim">Isolated virtual machines for running untrusted code.</p>
      </div>
    </div>
  </div>
</section>
