---
import { keyboards } from "../data/site";
import Plate from "./Plate.astro";

import { keys as layout, knob, fingerprint } from "../lib/tkl";
const keys = layout.map((k) => [k.x, k.y, k.w] as const);

const U = 40;
const P = 3;
const io = keyboards.io80;
const pro = keyboards.prometheus;
---

<section id="keyboards" class="sect kb-sect wrap" aria-labelledby="kb-h">
  <h2 id="kb-h" class="sect-label">
    <span>06</span> Keyboards
  </h2>

  <div class="kb-top">
    <figure class="kb-fig">
      <svg viewBox="-20 -70 930 400" role="img" aria-label="Line drawing of a tenkeyless keyboard with callouts">
        <rect class="case" x="-12" y="-12" width={18.25 * U + 24} height={6.25 * U + 24} rx="6"></rect>
        {keys.map(([x, y, w]) => (
          <rect x={x * U + P} y={y * U + P} width={w * U - 2 * P} height={U - 2 * P} rx="2" />
        ))}
        <circle class="knob" cx={(knob.x + 0.5) * U} cy={(knob.y + 0.5) * U} r="15"></circle>
        <circle class="knob-dot" cx={(knob.x + 0.5) * U} cy={(knob.y + 0.5) * U - 9} r="2"></circle>
        <path class="call" d={`M${17.75 * U + 15} ${0.5 * U} H${18.25 * U + 20}`}></path>
        <text x={18.25 * U + 26} y={0.5 * U + 4}>
          VOLUME KNOB
        </text>
        <rect
          class="fp"
          x={fingerprint.x * U + 2}
          y={fingerprint.y * U + 8}
          width={U - 4}
          height={U - 16}
          rx="6"
        ></rect>
        <path class="call" d={`M${17.25 * U - 2} ${3.75 * U} H${18.25 * U + 20}`}></path>
        <text x={18.25 * U + 26} y={3.75 * U + 4}>
          FINGERPRINT READER
        </text>
        <path class="call" d={`M${3.5 * U} ${3.75 * U} L${3.5 * U} 300 H300`}></path>
        <text x={3.5 * U + 10} y="294">
          PER-KEY LIGHTING
        </text>
        <path class="call" d={`M${8 * U} -12 V-40 H${8 * U - 160}`}></path>
        <text x={8 * U - 160} y="-46">
          8,000 HZ POLLING
        </text>
      </svg>
      <figcaption>Simplified drawing of the IO80 layout.</figcaption>
    </figure>

    <Plate id="keyboards" fig={4} />
  </div>

  <div class="kb-cols">
    <article>
      <p class="meta">
        <span>Project 15</span>
        <span>[HW]</span>
        <span>{io.stack}</span>
        <span>{io.dates}</span>
      </p>
      <h3 class="spec-name">
        {io.name}
        <span class="dim">, {io.what}</span>
      </h3>
      <p class="impact">{io.impact}</p>
      {io.notes.map((n) => (
        <p>{n}</p>
      ))}
      <dl class="gauges">
        <dt>Random key combinations without interference</dt>
        <dd>
          <span class="gauge" style="--v:1"></span>5,000 / 5,000
        </dd>
        <dt>Report rate</dt>
        <dd>
          <span class="gauge" style="--v:1"></span>8,000 Hz
        </dd>
      </dl>
    </article>

    <article>
      <p class="meta">
        <span>Project 16</span>
        <span>[HW]</span>
        <span>{pro.stack}</span>
        <span>{pro.dates}</span>
        <a href={pro.href} target="_blank">
          <span aria-hidden="true">↗</span> Source
        </a>
      </p>
      <h3 class="spec-name">
        {pro.name}
        <span class="dim">, {pro.what}</span>
      </h3>
      <p class="impact">{pro.impact}</p>
      {pro.notes.map((n) => (
        <p>{n}</p>
      ))}
      <div class="packet" role="table" aria-label="Prometheus summary">
        <div role="row" class="pk-row">
          <span role="cell" style="--s:2">
            Switches: mechanical
          </span>
          <span role="cell" style="--s:2">
            Sensors: magnetic
          </span>
        </div>
        <div role="row" class="pk-row">
          <span role="cell" style="--s:4">
            Actuation depth: set by the user
          </span>
        </div>
        <div role="row" class="pk-row">
          <span role="cell">60%</span>
          <span role="cell">→</span>
          <span role="cell">75%</span>
          <span role="cell">KiCad</span>
        </div>
      </div>
    </article>
  </div>
</section>
