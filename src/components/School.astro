---
import { education, service, awards } from "../data/site";
import { barcodePath } from "../lib/barcode";
const { exeter, stanford } = education;
---

<section id="school" class="sect school wrap" aria-labelledby="school-h">
  <h2 id="school-h" class="sect-label"><span>08</span> School</h2>

  <article class="pass" aria-label="Education: Stanford Online High School, grades 6 to 8, then Phillips Exeter Academy, class of 2027">
    <div class="pass-stub">
      <p class="lbl">Passenger</p>
      <p class="val-s">Noori, Anshul</p>
      <p class="lbl">Arrives</p>
      <p class="val-s">June 2027</p>
    </div>
    <div class="pass-main">
      <div class="pass-head">
        <p class="pass-co">Education<br /><span class="dim">Boarding pass</span></p>
        <svg class="barcode" viewBox="0 0 120 1" preserveAspectRatio="none" aria-hidden="true"
          ><path d={barcodePath("stanford-ohs-to-exeter-2027")}></path></svg>
      </div>
      <div class="pass-route">
        <div><p class="lbl">From, grades 6-8</p><p class="val-l">OHS</p><p class="val-s">Stanford Online High School</p></div>
        <p class="arrow" aria-hidden="true">►►</p>
        <div><p class="lbl">To, class of 2027</p><p class="val-l">PEA</p><p class="val-s">Phillips Exeter Academy</p></div>
      </div>
      <div class="pass-grid">
        {exeter.ap.map(([n, sc]) => <div><p class="lbl">AP {n}</p><p class="val-l">{sc}</p></div>)}
      </div>
    </div>
  </article>

  <div class="receipts">
    <article class="receipt" aria-label={exeter.name}>
      <p class="center">{exeter.name}<br />{exeter.place}</p>
      <p class="center dim">{exeter.when}</p>
      <p class="r-h">Coursework</p>
      <dl>
        {exeter.lines.map(([c, n, g]) => <><dt><span class="dim">{c}</span> {n}</dt><dd>{g || "--"}</dd></>)}
      </dl>
      <p class="r-h">Senior year</p>
      <ul>{exeter.senior.map((s) => <li>{s}</li>)}</ul>
    </article>

    <article class="receipt" aria-label={stanford.name}>
      <p class="center">{stanford.name}<br />{stanford.place}</p>
      <p class="center dim">{stanford.when}</p>
      <p class="r-h">Coursework</p>
      <dl>
        {stanford.lines.map(([c, n, g]) => <><dt><span class="dim">{c}</span> {n}</dt><dd>{g}</dd></>)}
      </dl>
      <p class="dim small">{stanford.note}</p>
    </article>

    <div class="awards">
      <h3 class="sub-label">Awards</h3>
      <ul class="dash">
        {awards.map(([a, b]) => <li>{a}{b && <span class="dim">, {b}</span>}</li>)}
      </ul>
    </div>
  </div>

  <h3 class="sub-label">Leadership &amp; service</h3>
  <ul class="service">
    {
      service.map((s) => (
        <li>
          <p class="svc-h">
            {s.href ? <a href={s.href}>{s.name}</a> : s.name}
            <span class="dim"> | {s.role}</span>
          </p>
          {s.notes.map((n) => <p>{n}</p>)}
        </li>
      ))
    }
  </ul>
</section>
