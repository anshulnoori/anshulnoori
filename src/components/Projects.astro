---
import { projects, smallProjects } from "../data/site";
// Homelab (05) and the two keyboards (06) are numbered after these.
const total = projects.length + smallProjects.length + 3;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="projects" class="sect projects wrap" aria-labelledby="projects-h">
  <h2 id="projects-h" class="sect-label"><span>04</span> Projects</h2>

  <p class="attn" aria-hidden="true">Now boarding:<br />projects 01-{pad(total)}</p>

  <ol class="specimens">
    {
      projects.map((p, i) => (
        <li id={p.id}>
          <p class="meta">
            <span>Project {pad(i + 1)}</span>
            <span>[{p.kind}]</span>
            <span>{p.stack}</span>
            {p.dates && <span>{p.dates}</span>}
            {p.href && (
              <a href={p.href}>
                <span aria-hidden="true">↗</span> Source
              </a>
            )}
          </p>
          <h3 class="spec-name">{p.name}<span class="dim">, {p.what}</span></h3>
          {p.notes.map((n) => (
            <p>{n}</p>
          ))}
        </li>
      ))
    }
  </ol>

  <h3 class="sub-label">Also</h3>
  <ul class="index">
    {
      smallProjects.map((p, i) => (
        <li>
          <span class="idx">{pad(projects.length + i + 1)}</span>
          <span class="kind">[{p.kind}]</span>
          <span class="nm">{p.href ? <a href={p.href}>{p.name}</a> : p.name}</span>
          <span class="desc">{p.what}</span>
          <span class="stk">{p.stack}</span>
          <span class="dt">{p.dates ?? ""}</span>
        </li>
      ))
    }
  </ul>
</section>
