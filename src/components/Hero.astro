---
import { person } from "../data/site";
const built = new Date();
const version = `v${built.getUTCFullYear()}.${String(built.getUTCMonth() + 1).padStart(2, "0")}`;
---

<section class="hero wrap">
  <div class="hero-top">
    <h1 class="wordmark">
      <span class="wordmark-block">Anshul Noori</span><sup class="ver">{version}</sup>
    </h1>
    <ul class="hero-links">
      <li><a href={`mailto:${person.email}`}><span aria-hidden="true">@</span> Email</a></li>
      <li><a href={`https://github.com/${person.github}`}><span aria-hidden="true">&gt;</span> GitHub</a></li>
      <li><a href="#contact"><span aria-hidden="true">↓</span> Contact</a></li>
    </ul>
  </div>

  <p class="lede">
    Student at Phillips Exeter Academy, class of 2027, and CTO of Topit AI. I work on build systems, graphics,
    and keyboards, and send the fixes upstream.
  </p>
</section>
