---
import { openSource } from "../data/site";
const repoUrl = (c: (typeof openSource)[number]) => `https://github.com/${c.owner}/${c.repo}`;
---

<section id="oss" class="sect oss wrap" aria-labelledby="oss-h">
  <h2 id="oss-h" class="sect-label"><span>03</span> Open source</h2>

  <div class="board-scroll">
    <table class="board">
      <thead>
        <tr><th scope="col">Upstream <span aria-hidden="true">↑</span></th><th scope="col" class="c-pr">PR</th><th
            scope="col" class="c-lang">Lang</th><th scope="col" class="c-date">Date</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
        {
          openSource.map((c, i) => (
            <tr class={i === 0 ? "is-hl" : undefined}>
              <td>
                <span class="cd">{c.code}</span> <a href={repoUrl(c)}>{c.repo}</a>
              </td>
              <td class="c-pr">{c.pr ? <a href={`${repoUrl(c)}/pull/${c.pr}`}>#{c.pr}</a> : "--"}</td>
              <td class="c-lang">{c.lang}</td>
              <td class="c-date">{c.date}</td>
              <td class={c.status === "MERGED" ? "st-ok" : "st-wait"}>{c.status === "MERGED" ? "Merged" : "Upcoming"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="caption">
    These patches came out of my own projects. Silt, my game engine, needed a graphics feature Macs lacked, so I
    added it to MoltenVK. The niks3 changes were first built for Topit's build cache.
  </p>

  <ol class="board-notes">
    {
      openSource.map((c) => (
        <li>
          <p class="meta">
            <span class="cd">{c.code}</span> {c.owner}/{c.repo} {c.pr ? `#${c.pr}` : ""} <span class="dim">· {c.what}</span>
          </p>
          {c.notes.map((n) => <p>{n}</p>)}
        </li>
      ))
    }
  </ol>
</section>
