---
export const sections = [
  ["about", "About"],
  ["work", "Work"],
  ["oss", "Open source"],
  ["projects", "Projects"],
  ["homelab", "Homelab"],
  ["keyboards", "Keyboards"],
  ["skills", "Skills"],
  ["school", "School"],
  ["contact", "Contact"],
] as const;
---

<header class="topbar">
  <nav class="tabs" aria-label="Sections">
    {
      sections.map(([id, label], i) => (
        <a href={`#${id}`} data-key={i + 1}>
          <span class="tab-n">{String(i + 1).padStart(2, "0")}</span> {label}
        </a>
      ))
    }
  </nav>
  <div class="colorbar" aria-hidden="true">
    <i style="--c:#e8343a"></i><i style="--c:#16a05d"></i><i style="--c:#2b3990"></i><i style="--c:#00aeef"></i><i
      style="--c:#fff200"></i><i style="--c:#ec008c"></i><i style="--c:#111"></i>
  </div>
  <button class="theme-btn" type="button" data-theme-toggle aria-label="Toggle light or dark theme">
    <kbd>M</kbd> Theme
  </button>
</header>
