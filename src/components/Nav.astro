---
import { cv } from "../lib/cv";

export const sections = [
  ["about", "About"],
  ["work", "Work"],
  ["oss", "Open source"],
  ["projects", "Projects"],
  ["homelab", "Homelab"],
  ["keyboards", "Keyboards"],
  ["skills", "Skills"],
  ["school", "School"],
  ["contact", "Contact"],
] as const;
---

<header class="topbar">
  <button class="menu-btn" type="button" popovertarget="tabs">
    Sections <span aria-hidden="true">▾</span>
  </button>
  <nav class="tabs" id="tabs" popover aria-label="Sections">
    {sections.map(([id, label], i) => (
      <a href={`#${id}`} data-key={i + 1}>
        <span class="tab-n">{String(i + 1).padStart(2, "0")}</span> {label}
      </a>
    ))}
  </nav>
  <div class="colorbar" aria-hidden="true">
    {["sea", "land", "sand", "ochre", "brick", "slate"].map((c) => (
      <i class={`sw sw-${c}`}></i>
    ))}
  </div>
  {cv && (
    <a class="cv-btn" href={cv.href} download={cv.file}>
      <span aria-hidden="true">↓</span> CV
    </a>
  )}
  <button class="theme-btn" type="button" data-theme-toggle aria-label="Toggle light or dark theme">
    <kbd>M</kbd> Theme
  </button>
</header>
