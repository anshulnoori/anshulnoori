---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import World from "../components/World.astro";
import About from "../components/About.astro";
import OpenSource from "../components/OpenSource.astro";
import Work from "../components/Work.astro";
import Projects from "../components/Projects.astro";
import Homelab from "../components/Homelab.astro";
import Keyboards from "../components/Keyboards.astro";
import Skills from "../components/Skills.astro";
import School from "../components/School.astro";
import Contact from "../components/Contact.astro";
---

<Base
  title="Anshul Noori"
  description="Anshul Noori: student at Phillips Exeter Academy, CTO of Topit AI, and contributor to Buck2, MoltenVK, SPIRV-Cross, and NixOS on Apple Silicon."
>
  <Nav />
  <main>
    <World />
    <About />
    <Work />
    <OpenSource />
    <Projects />
    <Homelab />
    <Keyboards />
    <Skills />
    <School />
    <Contact />
  </main>
  <aside class="keys" aria-label="Keyboard shortcuts" data-mode="page">
    <span data-for="orbit">
      <kbd>1</kbd>-<kbd>5</kbd> Places
    </span>
    <span data-for="orbit">
      <kbd>Drag</kbd> Spin
    </span>
    <span data-for="place">
      <kbd>←</kbd>
      <kbd>→</kbd> Next place
    </span>
    <span data-for="object">
      <kbd>Drag</kbd> Rotate
    </span>
    <span data-for="object">Type to press keys</span>
    <span data-for="place object">
      <kbd>Esc</kbd> Back
    </span>
    <span data-for="page">
      <kbd>1</kbd>-<kbd>9</kbd> Section
    </span>
    <span data-for="page orbit">
      <kbd>J</kbd>
      <kbd>K</kbd> Next / prev
    </span>
    <span data-for="page orbit place">
      <kbd>M</kbd> Light / dark
    </span>
  </aside>
  <script>
    import "../scripts/site";
  </script>
</Base>
